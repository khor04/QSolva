DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-flash-lite-latest
CORS_ORIGINS=["http://localhost:5173"]
# Business-hours clock for medium/low SLA targets — set this to the support
# team's real timezone, or SLA due times will be wrong.
BUSINESS_TIMEZONE=UTC
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
# Optional: Slack incoming webhook URL for admin-actionable alerts (critical/
# high tickets, SLA risk, escalations, new incidents). Leave unset to skip
# external alerts entirely — in-app notifications work either way.
ADMIN_ALERT_SLACK_WEBHOOK_URL=
# Optional: used to build a clickable ticket link in those Slack alerts.
APP_BASE_URL=http://localhost:5173
